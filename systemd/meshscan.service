[Unit]
Description=meshscan LoRa node: MeshCore chat or receive-only scanner
After=network.target
Conflicts=meshtasticd.service

[Service]
# MeshTerm's bundled site (openhop-core + pinned cffi/pycryptodome) for chat mode
Environment=PYTHONPATH=/usr/lib/meshterm/site
ExecStart=/opt/meshscan/venv/bin/python -u /opt/meshscan/meshscan.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
